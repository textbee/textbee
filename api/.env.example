PORT=3001
MONGO_URI=mongodb://adminUser:adminPassword@textbee-db:27017/textbee?authSource=admin

# to setup initial password
MONGO_ROOT_USER=adminUser
MONGO_ROOT_PASS=adminPassword

JWT_SECRET=secret # change this to a secure random string
JWT_EXPIRATION=60d

FRONTEND_URL=http://localhost:3000

#Update from Firebase service account json file
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_C509_CERT_URL=

MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_REPLY_TO=
ADMIN_EMAIL=
# Sender of account and usage notices. Defaults to textbee <notifications@textbee.dev>.
MAIL_FROM_NOTIFICATIONS=
# Reply-To of account and usage notices. Defaults to support@textbee.dev.
MAIL_REPLY_TO_NOTIFICATIONS=
# SES configuration set for account and usage notices. Unset sends without one.
SES_CONFIGURATION_SET_NOTICES=
# Secret that signs unsubscribe, card update and checkout links. Use the same value in every service that sends email.
EMAIL_LINK_SECRET=
# Public base URL of this API, used in email links. Defaults to https://api.textbee.dev.
API_PUBLIC_URL=
# Public base URL of the web app, used in email links. Defaults to https://app.textbee.dev.
APP_PUBLIC_URL=
# SNS topic whose bounce and complaint messages POST /api/v1/email/ses-events accepts. Required: while unset the route accepts nothing.
SES_EVENTS_TOPIC_ARN=

# Webhook delivery HTTP timeout in milliseconds (default 30000, min 10000, max 60000)
WEBHOOK_DELIVERY_TIMEOUT_MS=30000

# Auto-disable webhook subscriptions with high failure rate (cron runs daily)
WEBHOOK_AUTO_DISABLE_FAILURE_THRESHOLD=50
WEBHOOK_AUTO_DISABLE_LOOKBACK_DAYS=30
# Min failure rate 0 to 1 to disable (e.g. 0.50 = 50%; only disable when failures/total >= this)
WEBHOOK_AUTO_DISABLE_MIN_FAILURE_RATE=0.50

# SMS Queue Configuration
USE_SMS_QUEUE=false
REDIS_URL=redis://localhost:6379 # if queue is enabled,  redis url is required
# Max FCM messages per queue job
MAX_SMS_BATCH_SIZE=100
# Bulk sends are released in waves of this many messages, spaced by the
# device's configured send delay, so pushes never pile up ahead of the phone
BULK_DISPATCH_WINDOW=50
# Log a warning when a paced batch is projected to take longer than this
BULK_DISPATCH_MAX_SPREAD_HOURS=72
# How long FCM keeps an SMS push for an offline device before dropping it
FCM_SMS_TTL_SECONDS=259200
# Lifetime of the hourly heartbeat probe push
FCM_HEARTBEAT_TTL_SECONDS=1800
# Comma separated ids whose pushes are withheld. The rest of the send path is
# unchanged, so the messages stay in the usual states and carry errorCode
# FCM_SEND_SKIPPED
FCM_SEND_SKIP_USER_IDS=
FCM_SEND_SKIP_DEVICE_IDS=

# Settings returned to the android app on every heartbeat. A device document's
# configOverrides object wins over these.
SEND_SCHEDULER_V2_ENABLED=true
RECOVERY_POLL_ENABLED=false
UPDATE_NOTIFICATIONS_ENABLED=false
LATEST_APP_VERSION_CODE=18
LATEST_APP_VERSION_NAME=2.8.0

CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# OAuth client id(s) that Google sign-in tokens must be issued for. Must match
# the web app's NEXT_PUBLIC_GOOGLE_CLIENT_ID. Comma-separate for several clients.
# When unset, the audience is not checked and a warning is logged.
GOOGLE_CLIENT_ID=
# Set to cloudflare when the API runs behind that edge network, so the caller's
# address and region are read from its headers instead of the proxy hop. Unset,
# the address is the nearest trusted hop and no region is available. Only set
# this when the origin is actually reachable through that edge.
TRUSTED_PROXY=
# The API records the distinct origins each account is reached from: one row
# per account, channel and address, never one per request. Recording is on
# unless this is set to exactly "off". Read at runtime, so setting it and
# restarting is enough, with no rebuild.
ACCESS_FOOTPRINTS=
# Comma-separated user ids that skip daily, monthly and bulk send limits.
# Ban and email verification checks still apply. Read at runtime, so setting
# it and restarting is enough, with no rebuild.
LIMIT_EXEMPT_USER_IDS=
# Received SMS are stored and counted even when the account is over its plan
# limit. Set to exactly "reject" to refuse them with 429 instead. Read at
# runtime, so setting it and restarting is enough, with no rebuild.
RECEIVE_SMS_OVER_LIMIT=
# Hours between receivedAt and upload after which a received SMS does not send
# MESSAGE_RECEIVED webhooks. Default 48. Set to 0 to always send them.
RECEIVED_WEBHOOK_MAX_AGE_HOURS=

# Analytics and ad-platform conversion reporting.
# Leave ANALYTICS_PROVIDERS unset and nothing is sent to any external service.
# Comma separated, only "meta" is supported today. Reading it at runtime makes
# it a kill switch: unset it and restart, no rebuild needed.
ANALYTICS_PROVIDERS=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# When set, events go to Events Manager > Test events instead of live
# reporting. Remove it before running real campaigns.
META_CAPI_TEST_EVENT_CODE=

# Polar billing. Read by the code, so listed here even though a self-hosted
# instance without billing can leave them empty.
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
POLAR_DEFAULT_DISCOUNT_ID=
