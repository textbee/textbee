<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SMSGateway" parent="android:Theme.Material">
        <!-- Primary brand color. -->
        <item name="android:colorPrimary">#C4620A</item>
        <item name="android:colorPrimaryDark">#A04405</item>
        <!-- Secondary brand color. -->
        <item name="android:colorAccent">#B45309</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?android:attr/colorPrimaryDark</item>
        <!-- Dark mode specific overrides -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/background_primary</item>
        <item name="android:colorBackground">@color/background_primary</item>
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>
    
    <!-- Theme without action bar -->
    <style name="Theme.SMSGateway.NoActionBar" parent="android:Theme.Material.NoActionBar">
        <!-- Primary brand color. -->
        <item name="android:colorPrimary">#C4620A</item>
        <item name="android:colorPrimaryDark">#A04405</item>
        <!-- Secondary brand color. -->
        <item name="android:colorAccent">#B45309</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?android:attr/colorPrimaryDark</item>
        <!-- Dark mode specific overrides -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/background_primary</item>
        <item name="android:colorBackground">@color/background_primary</item>
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>
</resources>