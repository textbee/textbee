<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SMSGateway" parent="android:Theme.Material.Light.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="android:colorPrimary">#C4620A</item>
        <item name="android:colorPrimaryDark">#A04405</item>
        <!-- Secondary brand color. -->
        <item name="android:colorAccent">#B45309</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?android:attr/colorPrimaryDark</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
    </style>
    
    <!-- Theme without action bar -->
    <style name="Theme.SMSGateway.NoActionBar" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="android:colorPrimary">#C4620A</item>
        <item name="android:colorPrimaryDark">#A04405</item>
        <!-- Secondary brand color. -->
        <item name="android:colorAccent">#B45309</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?android:attr/colorPrimaryDark</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
    </style>
</resources>