<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up. Shared preferences stay on this phone: they hold
     the device id, the API key, the server config and the send markers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
