<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up. Device identity and send history stay on this phone. -->
<data-extraction-rules>
    <!-- PREF holds the device id, the API key and the server config -->
    <cloud-backup>
        <exclude domain="sharedpref" path="PREF.xml" />
        <exclude domain="sharedpref" path="sms_send_markers.xml" />
        <exclude domain="sharedpref" path="SMS_DEDUPE.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="PREF.xml" />
        <exclude domain="sharedpref" path="sms_send_markers.xml" />
        <exclude domain="sharedpref" path="SMS_DEDUPE.xml" />
    </device-transfer>
</data-extraction-rules>
